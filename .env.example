# ============================================================
# 基石服务栈 BasicStack —— 部署变量
# 用法：复制为 .env（docker compose 自动读取），按需修改。
#       所有变量都有内置默认值，不创建 .env 也能直接跑。
# ============================================================

# 数据根目录（所有服务的持久化数据/日志落盘位置）
DATA_ROOT=D:/local/basic-service-data

# 项目仓库目录（nginx 只读挂载给发布页用）
STACK_DIR=D:/local/basic-service

# 本栈基础网络名（容器间互访）
NETWORK_NAME=basic-net

# 跨项目互通的外部网络名（须与目标项目实际网络名一致）
ESG_NETWORK=esg-uat_esg
QDATA_NETWORK=docker_qdatanet
